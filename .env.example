# Rede Docker criada automaticamente pela Stack.
# Informe a sub-rede em CIDR (IP da rede + mascara). Se nao informar,
# sera criada a rede conecta-mais-network em 172.30.250.0/24.
DOCKER_NETWORK_NAME=conecta-mais-network
DOCKER_NETWORK_SUBNET=172.30.250.0/24
DOCKER_STATIC_IP=172.30.250.10

# Endereco HTTPS publico usado futuramente pelos MikroTiks
PUBLIC_BASE_URL=https://conecta.seudominio.com.br

# Gere um valor longo e exclusivo. Nao publique o .env real no GitHub.
ACTIVATION_TOKEN_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres

# Acesso ao painel e assinatura da sessão administrativa
ADMIN_PASSWORD=troque-esta-senha
ADMIN_USERNAME=admin
ADMIN_SESSION_SECRET=gere-outro-segredo-com-pelo-menos-32-caracteres

# Checkout Transparente Pix do Mercado Pago. O Access Token fica somente no backend.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
PIX_PRICE_5=1.00
PIX_PRICE_10=2.00
PIX_PRICE_15=3.00
PIX_PRICE_30=5.00
PIX_PRICE_60=8.00
