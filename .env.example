# Rede Docker externa que ja existe no Portainer e IP fixo livre nessa rede.
# A Stack apenas entra na rede; ela nao cria nem altera a sub-rede existente.
DOCKER_NETWORK_NAME=local-rede-external
DOCKER_STATIC_IP=10.12.0.205

# Endereco HTTPS publico usado futuramente pelos MikroTiks
PUBLIC_BASE_URL=https://conecta.seudominio.com.br

# Gere um valor longo e exclusivo. Nao publique o .env real no GitHub.
ACTIVATION_TOKEN_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres

# Acesso ao painel e assinatura da sessão administrativa
ADMIN_PASSWORD=troque-esta-senha
ADMIN_USERNAME=admin
ADMIN_SESSION_SECRET=gere-outro-segredo-com-pelo-menos-32-caracteres

# Checkout Transparente Pix do Mercado Pago. O Access Token fica somente no backend.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
PIX_BLOCKED_DOMAINS=facebook.com,facebook.net,fbcdn.net,instagram.com,cdninstagram.com,whatsapp.com,whatsapp.net,tiktok.com,tiktokcdn.com,twitter.com,x.com,twimg.com,youtube.com,youtu.be,googlevideo.com,google.com,connectivitycheck.gstatic.com,captive.apple.com,msftconnecttest.com
PIX_TEMP_RATE_LIMIT=1M/1M
PIX_PRICE_5=1.00
PIX_PRICE_10=2.00
PIX_PRICE_15=3.00
PIX_PRICE_30=5.00
PIX_PRICE_60=8.00
