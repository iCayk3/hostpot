# Docker: rede externa já criada e IP livre pertencente à sub-rede dela.
# A Stack somente entra nessa rede; não cria nem modifica sua sub-rede.
DOCKER_NETWORK_NAME=local-rede-external
DOCKER_STATIC_IP=10.12.0.205

# URL pública HTTPS acessível pelo navegador e pelos MikroTiks.
PUBLIC_BASE_URL=https://wifi.seudominio.com.br

# Gere dois valores diferentes com: openssl rand -base64 48
ACTIVATION_TOKEN_SECRET=troque-por-um-segredo-aleatorio-com-32-ou-mais-caracteres
ADMIN_SESSION_SECRET=troque-por-outro-segredo-aleatorio-com-32-ou-mais-caracteres

# Administrador inicial.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-por-uma-senha-forte-com-16-ou-mais-caracteres

# Janela temporária de dois minutos usada para pagamento.
PIX_TEMP_RATE_LIMIT=1M/1M
PIX_BLOCKED_DOMAINS=facebook.com,facebook.net,fbcdn.net,instagram.com,cdninstagram.com,whatsapp.com,whatsapp.net,tiktok.com,tiktokcdn.com,twitter.com,x.com,twimg.com,youtube.com,youtu.be,googlevideo.com,google.com,connectivitycheck.gstatic.com,captive.apple.com,msftconnecttest.com

# Mercado Pago e preços são configurados no painel Administração > Integrações.
# Estas variáveis antigas são opcionais e mantidas apenas por compatibilidade:
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
PIX_PRICE_5=
PIX_PRICE_10=
PIX_PRICE_15=
PIX_PRICE_30=
PIX_PRICE_60=
